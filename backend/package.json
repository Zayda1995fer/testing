{
  "name": "task-manager-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de práctica (Task Manager) para el tutorial de testing",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand test/unit",
    "test:smoke": "jest --runInBand test/integration/smoke.test.js",
    "test:coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./test/globalSetup.js",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/test/"
    ],
    "setupFiles": [
      "./test/setupEnv.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
